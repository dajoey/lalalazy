<Project Sdk="Microsoft.NET.Sdk">
  <!-- RotationHarness WHM (2026-10-04, SC11 round 7): proves the White Mage Invoke decisions offline by
       compiling the REAL, UNCHANGED job source (WHM.cs + WHM_Helper.cs at the pinned revision) against a
       harness-owned fake of the CustomComboFunctions game boundary. The job files are Compile-Included as
       links; nothing under src/ is edited by the harness. The fakes live only in this folder
       (Fakes.cs/FakeGame.cs) and are fork-owned, so the nightly upstream merge never sees them.
         dotnet build tests\GluttonyCombo.RotationHarness.WHM -c Release
         dotnet tests\GluttonyCombo.RotationHarness.WHM\bin\Release\net10.0-windows7.0\GluttonyCombo.RotationHarness.WHM.dll
       Prints PASS/FAIL per case; a clearly-marked CANARY case is EXPECTED to fail; ends "OK" and exits 0
       only when every real case passes AND the canary fails as expected. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>GluttonyCombo.RotationHarness</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1574;CS1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <DalamudLibPath>$(appdata)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Fakes.cs" />
    <Compile Include="FakeGame.cs" />
    <!-- ==== THE CODE UNDER TEST: the real White Mage job files, unchanged ==== -->
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\Combos\PvE\WHM\WHM.cs" Link="WHM\WHM.cs" />
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\Combos\PvE\WHM\WHM_Helper.cs" Link="WHM\WHM_Helper.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Dalamud">
      <HintPath>$(DalamudLibPath)Dalamud.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Dalamud.Common">
      <HintPath>$(DalamudLibPath)Dalamud.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="FFXIVClientStructs">
      <HintPath>$(DalamudLibPath)FFXIVClientStructs.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Lumina">
      <HintPath>$(DalamudLibPath)Lumina.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Lumina.Excel">
      <HintPath>$(DalamudLibPath)Lumina.Excel.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(DalamudLibPath)Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- ECommons is compiled from source so the ECommons usings in WHM.cs (EZ throttler aliases,
         CombatRole) resolve; no ECommons code runs in the tested paths. -->
    <ProjectReference Include="..\..\src\GluttonyCombo\ECommons\ECommons\ECommons.csproj" />
  </ItemGroup>
</Project>
