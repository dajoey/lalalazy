<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain console app, no Dalamud. Compiles src/LazyHub/LazyHub/Core/** directly: any Dalamud
       type leaking into Core breaks this build. Run it:
         dotnet build tests/LazyHub.Harness/LazyHub.Harness.csproj -c Release
         dotnet tests/LazyHub.Harness/bin/Release/net10.0/LazyHub.Harness.dll [repoRoot]
       It reads the real pluginmaster.json (the catalog drift guard) and the real icon files. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LazyHub.Harness</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\LazyHub\LazyHub\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The hub protocol Core (parser and models) is shared SOURCE too: LazyHub reads descriptors with it. -->
    <Compile Include="..\..\src\Shared\LalaHub\Core\**\*.cs" Link="LalaHubCore\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
