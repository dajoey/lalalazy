<Project Sdk="Microsoft.NET.Sdk">
  <!-- RotationHarness RDM (SC11 round 7): offline harness for the real, UNCHANGED Red Mage job source
       (RDM.cs + RDM_Helper.cs Compile-Included as links; nothing under src/ is edited by the harness).
       Everything the decisions READ (cooldowns, statuses, gauge bytes, target, presets, settings) comes
       from harness-owned fakes (Fakes.cs/FakeGame.cs), fork-owned so the nightly upstream merge never
       sees them. Built by copying the proven VPR spike (branch rot/harness-spike) per job, deliberately
       separate per job (pattern of the nine round-6 branches) so parallel tasks cannot conflict.
         dotnet build tests\GluttonyCombo.RotationHarness.RDM -c Release
         dotnet tests\GluttonyCombo.RotationHarness.RDM\bin\Release\net10.0-windows7.0\GluttonyCombo.RotationHarness.RDM.dll
       Prints PASS/FAIL per case; a clearly-marked CANARY case is EXPECTED to fail; ends "OK" and exits 0
       only when every real case passes AND the canary fails as expected. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>GluttonyCombo.RotationHarness.RDM</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1574;CS1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <DalamudLibPath>$(appdata)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Fakes.cs" />
    <Compile Include="FakeGame.cs" />
    <!-- ==== THE CODE UNDER TEST: the real Red Mage job files, unchanged ==== -->
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\Combos\PvE\RDM\RDM.cs" Link="RDM\RDM.cs" />
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\Combos\PvE\RDM\RDM_Helper.cs" Link="RDM\RDM_Helper.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Dalamud">
      <HintPath>$(DalamudLibPath)Dalamud.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Dalamud.Common">
      <HintPath>$(DalamudLibPath)Dalamud.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="FFXIVClientStructs">
      <HintPath>$(DalamudLibPath)FFXIVClientStructs.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Lumina">
      <HintPath>$(DalamudLibPath)Lumina.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Lumina.Excel">
      <HintPath>$(DalamudLibPath)Lumina.Excel.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(DalamudLibPath)Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
