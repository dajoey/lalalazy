<Project Sdk="Microsoft.NET.Sdk">
  <!-- BossMod IPC stall trace (v1.0.4.283): asserts the BMT| emit rules offline against the exact
       code that ships. Plain console app, no Dalamud. Compiles the REAL
       src/GluttonyCombo/GluttonyCombo/Services/IPC/IpcStallTrace.cs - the pure timing core the
       BossMod IPC subscriber wraps its endpoint calls in. Any Dalamud or ECommons type leaking
       into that file breaks this build, which is the point.
         dotnet build tests/GluttonyCombo.IpcStallTraceHarness -c Release
         dotnet tests/GluttonyCombo.IpcStallTraceHarness/bin/Release/net10.0/GluttonyCombo.IpcStallTraceHarness.dll
       Prints PASS/FAIL per case, "OK" and exit 0 when every case passes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GluttonyCombo.IpcStallTraceHarness</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1574;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\Services\IPC\IpcStallTrace.cs" Link="IpcStallTrace.cs" />
  </ItemGroup>
</Project>
