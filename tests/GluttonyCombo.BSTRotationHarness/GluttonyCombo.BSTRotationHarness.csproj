<Project Sdk="Microsoft.NET.Sdk">
  <!-- BST rebuild 2026-09-16: unit cases plus a familiar-lifecycle SIMULATOR that drives the real engine
       through 300 s fights at every level 1-50 and asserts the safety invariants (Program.cs).
       Plain console app, no Dalamud. Compiles the REAL
       src/GluttonyCombo/GluttonyCombo/Combos/PvE/BST/BST_RotationLogic.cs and BST_Enums.cs
       (t_02fe2681, the BST rotation card) so the compass/GCD-chain/familiar-loop selection
       logic is proven offline against the exact code that ships, per
       skill lalalazy-ffxiv references/rotation-logic-and-preset-actions.md ("prove selection
       logic in a throwaway console app with a byte-identical stock case").
         dotnet build tests\GluttonyCombo.BSTRotationHarness -c Release
         dotnet tests\GluttonyCombo.BSTRotationHarness\bin\Release\net10.0\GluttonyCombo.BSTRotationHarness.dll
       Prints PASS/FAIL per case, "OK" and exit 0 when every case passes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GluttonyCombo.BSTRotationHarness</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1574;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Crucible data + beast-pick ranking are shared SOURCE with LazyCrucible since 2026-09-21. -->
    <Compile Include="..\..\src\Shared\LalaCrucible\**\*.cs" Link="LalaCrucible\%(RecursiveDir)%(Filename)%(Extension)" />
    <Using Include="Lalalazy.Crucible" />
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\Combos\PvE\BST\BST_RotationLogic.cs" Link="BST_RotationLogic.cs" />
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\Combos\PvE\BST\BST_Helper.cs" Link="BST_Helper.cs" />
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\Combos\PvE\BST\BST_CrucibleLogic.cs" Link="BST_CrucibleLogic.cs" />
  </ItemGroup>
</Project>
