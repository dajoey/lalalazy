<Project Sdk="Microsoft.NET.Sdk">
  <!-- CleanseReloadCheck (2026-10-24 return round): the hot-reload path of a plugin carrying the
       cleanse gates, as a real assembly lifecycle. Loads the SHIPPED GluttonyCombo.dll into a
       collectible AssemblyLoadContext, runs the pure gate verdicts, unloads the context, reloads
       the assembly (the Dalamud hot-reload analogue) and runs the verdicts again: the gate types
       must load, answer, come back fresh (no in-flight state carried across) and complete under a
       timeout in both lives.
         dotnet build tests/GluttonyCombo.CleanseReloadCheck -c Release
         dotnet tests/GluttonyCombo.CleanseReloadCheck/bin/Release/net10.0-windows7.0/GluttonyCombo.CleanseReloadCheck.dll <path-to-GluttonyCombo.dll>
       Exits 0 only when every check passes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>GluttonyCombo.CleanseReloadCheck</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1574;CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
