<Project Sdk="Microsoft.NET.Sdk">
  <!-- Config-migration regression proof (card t_89a7ebec): compiles the REAL src/LazyCrafter/Configuration.cs
       (not a copy) against minimal stubs for the Dalamud/Core types it references, plus real Newtonsoft.Json,
       then asserts that a pre-rename config (v4, "DagobertAfterCraft" JSON key) deserializes, migrates and
       re-serializes without losing the setting. Same pattern as LazyCrafter.Harness: plain Sdk, no Dalamud.
       NOTE: the stubs below mirror InventorySources/RevenueBasis just enough to compile; the behaviour under
       test is Configuration's JSON shape, which does not depend on stub fidelity. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LazyCrafter.ConfigMigrate</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\LazyCrafter\Configuration.cs" Link="Configuration.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
