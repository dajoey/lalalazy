<Project Sdk="Microsoft.NET.Sdk">
  <!-- Shield Charge dash safety (bst1013). Plain console app, no Dalamud. Compiles the REAL
       src/GluttonyCombo/GluttonyCombo/Combos/PvE/BST/BST_DashSafety.cs - the landing verdict from
       BossMod Reborn's two Hints.IsDashSafe answers and the SG| dh= hold label - so the landing-only
       rule, the overcap-only label and the danger-landing / danger-enemy split are asserted offline
       against the exact code that ships. The file depends on nothing else, so the rotation engine can
       change without touching this harness. Any Dalamud type leaking in breaks this build.
         dotnet build tests/GluttonyCombo.DashSafetyHarness -c Release
         dotnet tests/GluttonyCombo.DashSafetyHarness/bin/Release/net10.0/GluttonyCombo.DashSafetyHarness.dll
       Prints PASS/FAIL per case, "OK" and exit 0 when every case passes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GluttonyCombo.DashSafetyHarness</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1574;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\Combos\PvE\BST\BST_DashSafety.cs" Link="BST_DashSafety.cs" />
  </ItemGroup>
</Project>
