<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LazyFoodBuff.UiHarness</RootNamespace>
    <AssemblyName>LazyFoodBuff.UiHarness</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <LalaSourceRoot Condition="'$(LalaSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..</LalaSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Dalamud" HintPath="$(DalamudLibPath)\Dalamud.dll" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudLibPath)\Dalamud.Bindings.ImGui.dll" />
    <None Include="$(DalamudLibPath)\cimgui.dll" Link="cimgui.dll" CopyToOutputDirectory="PreserveNewest" />
    <Using Include="LazyFoodBuff" />
  </ItemGroup>

  <!-- Shared render core: rasterizer, PNG writer, game-look setup. -->
  <ItemGroup>
    <Compile Include="..\HarnessShared\UiRender\*.cs" Link="UiRender\%(Filename)%(Extension)" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LalaSourceRoot</_Parameter1>
      <_Parameter2>$(LalaSourceRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The real window, chrome, config model, ranking and wire-format sources; only the game and runtime boundary is stubbed (Stubs.cs). -->
  <ItemGroup>
    <Compile Include="$(LalaSourceRoot)\src\LazyFoodBuff\LazyFoodBuff\ConfigWindow.cs" Link="Real\ConfigWindow.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyFoodBuff\LazyFoodBuff\FoodUiChrome.cs" Link="Real\FoodUiChrome.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyFoodBuff\LazyFoodBuff\Configuration.cs" Link="Real\Configuration.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyFoodBuff\LazyFoodBuff\FoodRecommender.cs" Link="Real\FoodRecommender.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyFoodBuff\LazyFoodBuff\FoodTelemetryFormat.cs" Link="Real\FoodTelemetryFormat.cs" />
    <Compile Include="$(LalaSourceRoot)\src\Shared\LalaUiKit\**\*.cs" Link="Real\LalaUiKit\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
