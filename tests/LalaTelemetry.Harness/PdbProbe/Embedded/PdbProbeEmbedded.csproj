<Project Sdk="Microsoft.NET.Sdk">
  <!-- Probe for tests/LalaTelemetry.Harness: same source as the None probe, PDB embedded in the DLL. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PdbProbeEmbedded</AssemblyName>
    <RootNamespace>PdbProbe</RootNamespace>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Thrower.cs" />
  </ItemGroup>
</Project>
