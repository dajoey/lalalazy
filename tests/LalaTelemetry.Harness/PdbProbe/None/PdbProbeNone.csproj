<Project Sdk="Microsoft.NET.Sdk">
  <!-- Control probe for tests/LalaTelemetry.Harness: same source, no PDB at all (what packaging ships today). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PdbProbeNone</AssemblyName>
    <RootNamespace>PdbProbe</RootNamespace>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Thrower.cs" />
  </ItemGroup>
</Project>
