<Project Sdk="Microsoft.NET.Sdk">
  <!-- LazyCrucible offline harness (2026-09-21). Plain console app, no Dalamud. Compiles the REAL shared
       Crucible data/ranking (src/Shared/LalaCrucible) and LazyCrucible's pure formation logic
       (src/LazyCrucible/FormationLogic.cs): the familiar-selection latch, the screen gate, the horn
       membership delta, the roster plan, and replays of the live defects they fix.
         dotnet build tests/LazyCrucible.Harness -c Release
         dotnet tests/LazyCrucible.Harness/bin/Release/net10.0/LazyCrucible.Harness.dll
       Prints FAIL per failing case, "OK (n checks)" and exit 0 when every case passes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LazyCrucible.Harness</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1574;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Shared\LalaCrucible\**\*.cs" Link="LalaCrucible\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\LazyCrucible\FormationLogic.cs" Link="FormationLogic.cs" />
    <!-- Phase 2 (selection screens): generated item table and board graphs, the pure policies, the guide model. -->
    <Compile Include="..\..\src\LazyCrucible\Data\**\*.cs" Link="Data\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\LazyCrucible\Policy\**\*.cs" Link="Policy\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\LazyCrucible\Guide\CrucibleGuide.cs" Link="Guide\CrucibleGuide.cs" />
    <None Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\LazyCrucible\Guide\CrucibleGuide.json" Link="CrucibleGuide.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\src\LazyCrucible\Guide\CrucibleGuide.json')" />
    <Using Include="Lalalazy.Crucible" />
  </ItemGroup>
</Project>
