<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain console app, no Dalamud. Compiles the REAL
       src/GluttonyCombo/GluttonyCombo/Services/IPC/LogEmitGate.cs (the throttle behind the
       ConflictingPlugins periodic-check failure line, v1.0.4.233) so the shipped window/burst
       is asserted offline against the exact code that ships, by replaying the measured
       2026-09-22 incident from ffxivdb (359 identical WRNs, 12:49 to 21:30 ET). Any Dalamud
       type leaking into that file breaks this build, which is the point.
         dotnet build tests\GluttonyCombo.ConflictCheckHarness -c Release
         dotnet tests\GluttonyCombo.ConflictCheckHarness\bin\Release\net10.0\GluttonyCombo.ConflictCheckHarness.dll
       Prints PASS/FAIL per case, "OK" and exit 0 when every case passes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GluttonyCombo.ConflictCheckHarness</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1574;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\Services\IPC\LogEmitGate.cs" Link="LogEmitGate.cs" />
    <!-- bst1013: stock-BMR conflict probes. BossModRebornState turns stock IPC replies (Presets.Get JSON,
         Configuration console replies) into the verdicts; ConflictProbeFailure is the per-probe runner and the
         named failure line. PresetSamples.cs holds real-shaped Presets.Get replies. -->
    <Compile Include="BossModRebornCases.cs" />
    <Compile Include="PresetSamples.cs" />
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\Services\IPC_Subscriber\BossModRebornState.cs" Link="BossModRebornState.cs" />
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\Data\Conflicts\ConflictProbeFailure.cs" Link="ConflictProbeFailure.cs" />
  </ItemGroup>
</Project>
