<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AutoPotion.UiHarness</RootNamespace>
    <AssemblyName>AutoPotion.UiHarness</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591;CS1574</NoWarn>
    <LalaSourceRoot Condition="'$(LalaSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..</LalaSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Dalamud" HintPath="$(DalamudLibPath)\Dalamud.dll" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudLibPath)\Dalamud.Bindings.ImGui.dll" />
    <None Include="$(DalamudLibPath)\cimgui.dll" Link="cimgui.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Shared render core: rasterizer, PNG writer, game-look setup. -->
  <ItemGroup>
    <Compile Include="..\HarnessShared\UiRender\*.cs" Link="UiRender\%(Filename)%(Extension)" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LalaSourceRoot</_Parameter1>
      <_Parameter2>$(LalaSourceRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The real window, chrome, configuration and telemetry sources, linked and never copied.
       Only the game/runtime boundary (Plugin services, data sheets, textures) is stubbed in Stubs.cs. -->
  <ItemGroup>
    <Compile Include="$(LalaSourceRoot)\src\AutoPotion\AutoPotion\ConfigWindow.cs" Link="Real\ConfigWindow.cs" />
    <Compile Include="$(LalaSourceRoot)\src\AutoPotion\AutoPotion\AutoPotionChrome.cs" Link="Real\AutoPotionChrome.cs" />
    <Compile Include="$(LalaSourceRoot)\src\AutoPotion\AutoPotion\Configuration.cs" Link="Real\Configuration.cs" />
    <Compile Include="$(LalaSourceRoot)\src\AutoPotion\AutoPotion\PotionTelemetry.cs" Link="Real\PotionTelemetry.cs" />
    <Compile Include="$(LalaSourceRoot)\src\AutoPotion\AutoPotion\PotionTelemetryFormat.cs" Link="Real\PotionTelemetryFormat.cs" />
    <Compile Include="$(LalaSourceRoot)\src\Shared\LalaUiKit\**\*.cs" Link="Real\LalaUiKit\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
