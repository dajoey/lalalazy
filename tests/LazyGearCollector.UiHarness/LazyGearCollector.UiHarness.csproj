<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LazyGearCollector.UiHarness</RootNamespace>
    <AssemblyName>LazyGearCollector.UiHarness</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <LalaSourceRoot Condition="'$(LalaSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..</LalaSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Dalamud" HintPath="$(DalamudLibPath)\Dalamud.dll" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudLibPath)\Dalamud.Bindings.ImGui.dll" />
    <None Include="$(DalamudLibPath)\cimgui.dll" Link="cimgui.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Shared render core: rasterizer, PNG writer, game-look setup. -->
  <ItemGroup>
    <Compile Include="..\HarnessShared\UiRender\*.cs" Link="UiRender\%(Filename)%(Extension)" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LalaSourceRoot</_Parameter1>
      <_Parameter2>$(LalaSourceRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The real window, chrome, models, planner, configuration and shared kit. Only the plugin services,
       the inventory scanner and the shop sheet are stubbed (Stubs.cs). -->
  <ItemGroup>
    <Compile Include="$(LalaSourceRoot)\src\LazyGearCollector\CollectorWindow.cs" Link="Real\CollectorWindow.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyGearCollector\CollectorChrome.cs" Link="Real\CollectorChrome.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyGearCollector\CollectionModels.cs" Link="Real\CollectionModels.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyGearCollector\Planner.cs" Link="Real\Planner.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyGearCollector\Configuration.cs" Link="Real\Configuration.cs" />
    <Compile Include="$(LalaSourceRoot)\src\Shared\LalaUiKit\**\*.cs" Link="Real\LalaUiKit\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
