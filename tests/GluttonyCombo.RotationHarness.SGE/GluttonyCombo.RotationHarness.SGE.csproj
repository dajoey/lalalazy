<Project Sdk="Microsoft.NET.Sdk">
  <!-- RotationHarness SGE (2026-10-04, SC11 round 7): a Sage harness that proves the Eukrasian
       Dosis refresh and Phlegma charge decisions offline by compiling the REAL, UNCHANGED job
       source (SGE.cs + SGE_Helper.cs at the pinned revision) against a harness-owned fake of the
       CustomComboFunctions game boundary. The job files are Compile-Included as links; nothing
       under src/ is edited by the harness. The fakes live only in this folder (Fakes.cs/FakeGame.cs)
       and are fork-owned, so the nightly upstream merge never sees them.
         dotnet build tests\GluttonyCombo.RotationHarness.SGE -c Release
         dotnet tests\GluttonyCombo.RotationHarness.SGE\bin\Release\net10.0-windows7.0\GluttonyCombo.RotationHarness.SGE.dll
       Prints PASS/FAIL per case; a clearly-marked CANARY case is EXPECTED to fail; ends "OK" and
       exits 0 only when every real case passes AND the canary fails as expected. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>GluttonyCombo.RotationHarness.SGE</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1574;CS1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <DalamudLibPath>$(appdata)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Fakes.cs" />
    <Compile Include="FakeGame.cs" />
    <!-- ==== THE CODE UNDER TEST: the real Sage job files, unchanged ==== -->
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\Combos\PvE\SGE\SGE.cs" Link="SGE\SGE.cs" />
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\Combos\PvE\SGE\SGE_Helper.cs" Link="SGE\SGE_Helper.cs" />
    <!-- The real pure out-of-combat gate: the GroupDamageIncoming fake delegates its combat rule
         to the exact OutOfCombatGate.MayDetectIncomingDamage that ships. -->
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\AutoRotation\OutOfCombatGate.cs" Link="OutOfCombatGate.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Dalamud">
      <HintPath>$(DalamudLibPath)Dalamud.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Dalamud.Common">
      <HintPath>$(DalamudLibPath)Dalamud.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="FFXIVClientStructs">
      <HintPath>$(DalamudLibPath)FFXIVClientStructs.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Lumina">
      <HintPath>$(DalamudLibPath)Lumina.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Lumina.Excel">
      <HintPath>$(DalamudLibPath)Lumina.Excel.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(DalamudLibPath)Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- ECommons is compiled from source so the ECommons usings in the SGE files resolve; no
         ECommons code runs in the tested paths. -->
    <ProjectReference Include="..\..\src\GluttonyCombo\ECommons\ECommons\ECommons.csproj" />
  </ItemGroup>
</Project>
