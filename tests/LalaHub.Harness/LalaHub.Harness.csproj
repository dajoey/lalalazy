<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain console app, no Dalamud. Compiles src/Shared/LalaHub/Core/** directly: any Dalamud type
       leaking into Core breaks this build. Run it as a lint before any release that touches the hub
       protocol or an adapter:
         dotnet build tests/LalaHub.Harness/LalaHub.Harness.csproj -c Release
         dotnet tests/LalaHub.Harness/bin/Release/net10.0/LalaHub.Harness.dll -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LalaHub.Harness</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Shared\LalaHub\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
