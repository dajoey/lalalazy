<Project Sdk="Microsoft.NET.Sdk">
  <!-- LazyWTMath UI harness. Two jobs: the original presentation checks, and real-source UI rendering to PNG.
       The real LazyWTMathWindow, LazyWTMathChrome, LazyWTMathPresentation sources, the real solver (PerfectTails) and the
       shared UI kit are compiled by link; only the game boundary (PlayerState) and the plugin's static holder are stubbed
       in Stubs.cs. Needs an existing Dalamud runtime folder through DalamudLibPath (no restore, no download).
       Built-in look writes output/*.png; the game switch (see README.md) writes output/game/*.png. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LazyWTMath.UiHarness</RootNamespace>
    <AssemblyName>LazyWTMath.UiHarness</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LalaSourceRoot Condition="'$(LalaSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..</LalaSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Dalamud" HintPath="$(DalamudLibPath)\Dalamud.dll" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudLibPath)\Dalamud.Bindings.ImGui.dll" />
    <None Include="$(DalamudLibPath)\cimgui.dll" Link="cimgui.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Shared render core: rasterizer, PNG writer, game-look setup. -->
  <ItemGroup>
    <Compile Include="..\HarnessShared\UiRender\*.cs" Link="UiRender\%(Filename)%(Extension)" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LalaSourceRoot</_Parameter1>
      <_Parameter2>$(LalaSourceRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Stubs.cs" />
  </ItemGroup>

  <!-- The real plugin sources under test. -->
  <ItemGroup>
    <Compile Include="$(LalaSourceRoot)\src\LazyWTMath\LazyWTMath\LazyWTMathWindow.cs" Link="Real\LazyWTMathWindow.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyWTMath\LazyWTMath\LazyWTMathChrome.cs" Link="Real\LazyWTMathChrome.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyWTMath\LazyWTMath\LazyWTMathPresentation.cs" Link="Real\LazyWTMathPresentation.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyWTMath\LazyWTMath\LazyWTMathOverlayStyle.cs" Link="Real\LazyWTMathOverlayStyle.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyWTMath\LazyWTMath\PerfectTails.cs" Link="Real\PerfectTails.cs" />
    <Compile Include="$(LalaSourceRoot)\src\Shared\LalaUiKit\**\*.cs" Link="Real\LalaUiKit\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
