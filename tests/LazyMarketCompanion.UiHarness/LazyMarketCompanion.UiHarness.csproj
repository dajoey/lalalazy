<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LazyMarketCompanion.UiHarness</RootNamespace>
    <AssemblyName>LazyMarketCompanion.UiHarness</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CA1416;1591;CS8618;CS0649;CS0169;CS0414</NoWarn>
    <LalaSourceRoot Condition="'$(LalaSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..</LalaSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Dalamud" HintPath="$(DalamudLibPath)\Dalamud.dll" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudLibPath)\Dalamud.Bindings.ImGui.dll" />
    <None Include="$(DalamudLibPath)\cimgui.dll" Link="cimgui.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Shared render core: rasterizer, PNG writer, game-look setup. -->
  <ItemGroup>
    <Compile Include="..\HarnessShared\UiRender\*.cs" Link="UiRender\%(Filename)%(Extension)" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LalaSourceRoot</_Parameter1>
      <_Parameter2>$(LalaSourceRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The real windows, chrome, tab, tooltip, shared kit and every Dalamud-free core they draw from. -->
  <ItemGroup>
    <Compile Include="$(LalaSourceRoot)\src\LazyMarketCompanion\Windows\MarketChrome.cs" Link="Real\Windows\MarketChrome.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyMarketCompanion\Windows\ConfigWindow.cs" Link="Real\Windows\ConfigWindow.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyMarketCompanion\Windows\AutoMarketPanelWindow.cs" Link="Real\Windows\AutoMarketPanelWindow.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyMarketCompanion\Windows\AutoMarketBagView.cs" Link="Real\Windows\AutoMarketBagView.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyMarketCompanion\Inventory\InventoryTab.cs" Link="Real\Inventory\InventoryTab.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyMarketCompanion\Inventory\OwnerTooltip.cs" Link="Real\Inventory\OwnerTooltip.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyMarketCompanion\Inventory\Core\*.cs" Link="Real\Inventory\Core\%(Filename)%(Extension)" />
    <Compile Include="$(LalaSourceRoot)\src\LazyMarketCompanion\Configuration.cs" Link="Real\Configuration.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyMarketCompanion\SaleHistoryPricing.cs" Link="Real\SaleHistoryPricing.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyMarketCompanion\MarketTelemetryFormat.cs" Link="Real\MarketTelemetryFormat.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazyMarketCompanion\AutoMarket\*.cs" Link="Real\AutoMarket\%(Filename)%(Extension)" />
    <Compile Remove="$(LalaSourceRoot)\src\LazyMarketCompanion\AutoMarket\AutoMarketService.cs" />
    <Compile Remove="$(LalaSourceRoot)\src\LazyMarketCompanion\AutoMarket\CategoryAutoAssignService.cs" />
    <Compile Include="$(LalaSourceRoot)\src\Shared\LalaUiKit\**\*.cs" Link="Real\LalaUiKit\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(LalaSourceRoot)\src\Shared\LalaTelemetry\Core\*.cs" Link="Real\LalaTelemetry\Core\%(Filename)%(Extension)" />
    <Compile Include="$(LalaSourceRoot)\src\Shared\LalaTelemetry\ReportPopup.cs" Link="Real\LalaTelemetry\ReportPopup.cs" />
  </ItemGroup>
</Project>
