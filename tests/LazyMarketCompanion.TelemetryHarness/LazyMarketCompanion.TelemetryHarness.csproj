<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain console app, no Dalamud. Compiles the REAL
       src/LazyMarketCompanion/MarketTelemetryFormat.cs (the pure half of LMC's price
       decision tap, v0.1.4.0) plus the real MarketSlot record, so the emitted line
       format and the quantity rule are asserted offline, against the exact code that
       ships. Any Dalamud type leaking into those files breaks this build, which is
       the point.
         dotnet build tests\LazyMarketCompanion.TelemetryHarness -c Release
         dotnet tests\LazyMarketCompanion.TelemetryHarness\bin\Release\net10.0\LazyMarketCompanion.TelemetryHarness.dll
       Prints PASS/FAIL per case, "OK" and exit 0 when every case passes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LazyMarketCompanion.TelemetryHarness</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1574;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\LazyMarketCompanion\MarketTelemetryFormat.cs" Link="MarketTelemetryFormat.cs" />
    <Compile Include="..\..\src\LazyMarketCompanion\AutoMarket\AutoMarketPlanner.cs" Link="AutoMarketPlanner.cs" />
  </ItemGroup>
</Project>
