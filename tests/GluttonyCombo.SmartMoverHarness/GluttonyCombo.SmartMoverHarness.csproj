<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain console app, no Dalamud. Compiles the REAL SmartMover pure files
       (DangerZoneModel.cs, SmartMoverCore.cs, MovementTelemetryFormat.cs) so the
       movement decision engine is asserted offline against the exact code that
       ships. Any Dalamud type leaking into those files breaks this build, which
       is the point.
         dotnet build tests\GluttonyCombo.SmartMoverHarness -c Release
         dotnet tests\GluttonyCombo.SmartMoverHarness\bin\Release\net10.0\GluttonyCombo.SmartMoverHarness.dll
       Prints PASS/FAIL per case, "OK" and exit 0 when every case passes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GluttonyCombo.SmartMoverHarness</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1574;CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\AutoRotation\DangerZoneModel.cs" Link="DangerZoneModel.cs" />
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\AutoRotation\SmartMoverCore.cs" Link="SmartMoverCore.cs" />
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\AutoRotation\MovementGateCore.cs" Link="MovementGateCore.cs" />
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\AutoRotation\MovementTelemetryFormat.cs" Link="MovementTelemetryFormat.cs" />
  </ItemGroup>
</Project>
