<Project Sdk="Microsoft.NET.Sdk">
  <!-- Packaging check for the release zip (t_1a91db8f): loads the SHIPPED LazyCrafter.dll out of an extracted
       copy of plugins/LazyCrafter/testing/testing.zip in its own AssemblyLoadContext - so a transitive dependency
       that lives only in bin/ and never makes it into the zip fails here exactly as it fails in-game. Compiles
       nothing from src/; the assembly under test is the packaged binary. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LazyCrafter.ZipProbe</RootNamespace>
    <IsPackable>false</IsPackable>
    <DalamudLibPath>$(APPDATA)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Lumina"><HintPath>$(DalamudLibPath)Lumina.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="Lumina.Excel"><HintPath>$(DalamudLibPath)Lumina.Excel.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
</Project>
