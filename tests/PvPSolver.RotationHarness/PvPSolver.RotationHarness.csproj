<Project Sdk="Microsoft.NET.Sdk">
  <!-- PvPSolver rotation-review harness. Plain console app. Offline proofs for the reviewed PvP rotation
       fixes, each stated with exactly one proof tier:
         T1  pure decision core (src/PvPSolver/PvPSolver.Basic/Decisions/*.cs, compiled in here directly),
             truth-table tested, plus a canary that must fail;
         T2  source-shape test: reads the real source file and fails on the old text, passes on the new.
       Source root: env PVPROT_SRC (path of a src/PvPSolver folder, used to replay the tests against the
       old tree), else the src/PvPSolver folder found above this binary.
         dotnet run -c Release (project tests\PvPSolver.RotationHarness)
       Prints PASS/FAIL per case, "OK (n checks, canary failed as expected)" and exit 0 when every case
       passes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PvPSolver.RotationHarness</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CS0436: the Decisions files are compiled into this assembly AND exist in the referenced PvPSolver.Basic;
         the local copy wins, which is the point: the files must compile standalone. -->
    <NoWarn>$(NoWarn);CS0436;CS1574;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="Cases\*.cs" />
    <!-- Fork-only pure decision cores (no Dalamud or game types): compiled in directly so T1 proves the files standalone. -->
    <Compile Include="..\..\src\PvPSolver\PvPSolver.Basic\Decisions\*.cs" Link="Decisions\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only for the real ActionID enum and the reflection proof of ModifySmitePvP. -->
    <ProjectReference Include="..\..\src\PvPSolver\PvPSolver\PvPSolver.csproj" />
  </ItemGroup>
</Project>
