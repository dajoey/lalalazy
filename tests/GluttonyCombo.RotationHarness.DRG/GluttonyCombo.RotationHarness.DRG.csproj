<Project Sdk="Microsoft.NET.Sdk">
  <!-- RotationHarness DRG (2026-10-04, SC11 round 6): proves real Dragoon Invoke decisions OFFLINE by
       compiling the REAL, UNCHANGED job source (DRG.cs + DRG_Helper.cs from origin/main) against a
       harness-owned fake of the CustomComboFunctions game boundary (Fakes.cs/FakeGame.cs), per notebook
       "Projects/FFXIV Job Rotation Review 2026-10/Offline Harness Approach" sections 3+9. The job files are
       Compile-Included as links; nothing under src/ is edited by the harness. DRG_Config.cs and
       DRG_PositionalHints.cs are NOT linked: the Config defaults are mirrored in Fakes.cs and the positional
       hint reporter is a no-op (IPC side channel, out of the tested boundary). Fork-owned files only, so the
       nightly upstream merge never sees them.
         dotnet build tests\GluttonyCombo.RotationHarness.DRG -c Release
         dotnet tests\GluttonyCombo.RotationHarness.DRG\bin\Release\net10.0-windows7.0\GluttonyCombo.RotationHarness.DRG.dll
       Prints PASS/FAIL per case; a clearly-marked CANARY case is EXPECTED to fail; ends "OK" and exits 0
       only when every real case passes AND the canary fails as expected. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <RootNamespace>GluttonyCombo.RotationHarness</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1574;CS1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <DalamudLibPath>$(appdata)\XIVLauncher\addon\Hooks\dev\</DalamudLibPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Fakes.cs" />
    <Compile Include="FakeGame.cs" />
    <!-- ==== THE CODE UNDER TEST: the real Dragoon job files, unchanged ==== -->
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\Combos\PvE\DRG\DRG.cs" Link="DRG\DRG.cs" />
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\Combos\PvE\DRG\DRG_Helper.cs" Link="DRG\DRG_Helper.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Dalamud">
      <HintPath>$(DalamudLibPath)Dalamud.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Dalamud.Common">
      <HintPath>$(DalamudLibPath)Dalamud.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="FFXIVClientStructs">
      <HintPath>$(DalamudLibPath)FFXIVClientStructs.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Lumina">
      <HintPath>$(DalamudLibPath)Lumina.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Lumina.Excel">
      <HintPath>$(DalamudLibPath)Lumina.Excel.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(DalamudLibPath)Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- ECommons is compiled from source so `using static ECommons.DalamudServices.Svc` in DRG_Helper
         resolves; no ECommons code runs in the tested paths (ClientState is only read inside Opener(),
         which the cases keep disabled). -->
    <ProjectReference Include="..\..\src\GluttonyCombo\ECommons\ECommons\ECommons.csproj" />
  </ItemGroup>
</Project>
