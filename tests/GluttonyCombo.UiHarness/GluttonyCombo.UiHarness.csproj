<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GluttonyCombo.UiHarness</RootNamespace>
    <AssemblyName>GluttonyCombo.UiHarness</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LalaSourceRoot Condition="'$(LalaSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..</LalaSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Dalamud" HintPath="$(DalamudLibPath)\Dalamud.dll" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudLibPath)\Dalamud.Bindings.ImGui.dll" />
    <None Include="$(DalamudLibPath)\cimgui.dll" Link="cimgui.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(LalaSourceRoot)\src\GluttonyCombo\GluttonyCombo\Window\GluttonyChrome.cs" Link="Real\GluttonyChrome.cs" />
    <Compile Include="$(LalaSourceRoot)\src\GluttonyCombo\GluttonyCombo\Window\GluttonyShellNavigation.cs" Link="Real\GluttonyShellNavigation.cs" />
    <Compile Include="$(LalaSourceRoot)\src\Shared\LalaUiKit\**\*.cs" Link="Real\LalaUiKit\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="$(LalaSourceRoot)\tests\HarnessShared\UiRender\Rasterizer.cs" Link="Real\Rasterizer.cs" />
  </ItemGroup>
</Project>
