<Project Sdk="Microsoft.NET.Sdk">
  <!-- Out-of-range hard target (v1.0.4.258): asserts the fallback semantics offline against the exact
       code that ships. Plain console app, no Dalamud. Compiles the REAL
       src/GluttonyCombo/GluttonyCombo/AutoRotation/RangeFallbackGate.cs - the pure decision core
       ExecuteST / ExecuteAoE consult when the chosen action cannot reach the chosen enemy.
         dotnet build tests/GluttonyCombo.RangeFallbackHarness -c Release
         dotnet tests/GluttonyCombo.RangeFallbackHarness/bin/Release/net10.0/GluttonyCombo.RangeFallbackHarness.dll
       Prints PASS/FAIL per case, "OK" and exit 0 when every case passes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GluttonyCombo.RangeFallbackHarness</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1574;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\AutoRotation\RangeFallbackGate.cs" Link="RangeFallbackGate.cs" />
  </ItemGroup>
</Project>
