<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain console app, no Dalamud. Compiles the REAL pure shopping-list sources
       (src/ArmoireAutoFill/Data/Shopping/*.cs) so the KS1 encoder and the selection
       logic are asserted offline against the exact code that ships.
       Fixture data = Joey's real Knightshopper per-currency list files
       (Knightshopper/configs/*.json, dumped 2026-10-07), embedded as tuples.
         dotnet build tests/ArmoireAutoFill.ShoppingListHarness -c Release
         dotnet tests/ArmoireAutoFill.ShoppingListHarness/bin/Release/net10.0/ArmoireAutoFill.ShoppingListHarness.dll
       Prints PASS/FAIL per case, "OK" and exit 0 when every case passes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ArmoireAutoFill.ShoppingListHarness</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1574;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\ArmoireAutoFill\Data\Shopping\ShoppingModels.cs" Link="ShoppingModels.cs" />
    <Compile Include="..\..\src\ArmoireAutoFill\Data\Shopping\KnightshopperShare.cs" Link="KnightshopperShare.cs" />
    <Compile Include="..\..\src\ArmoireAutoFill\Data\Shopping\ShoppingListBuilder.cs" Link="ShoppingListBuilder.cs" />
  </ItemGroup>
</Project>
