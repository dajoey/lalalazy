<Project Sdk="Microsoft.NET.Sdk">
  <!-- LazySkywardTracker UI harness. Compiles the REAL window and chrome sources (linked, never copied) and stubs
       only the game/runtime boundary (plugin services, achievement state, inventory scan) in Stubs.cs.
       Plain run:   offline checks of the live-state decisions and row layout maths, plus a built-in render.
       game switch: game-look render to output/game (needs DalamudLibPath, LALA_UI_ASSET_DIR, optional LALA_UI_SCALE). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>LazySkywardTracker.UiHarness</RootNamespace>
    <AssemblyName>LazySkywardTracker.UiHarness</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The harness shadows Dalamud.Interface.UiBuilder (icon font only); the local type wins on purpose. -->
    <NoWarn>$(NoWarn);CS0436;CA1416</NoWarn>
    <LalaSourceRoot Condition="'$(LalaSourceRoot)' == ''">$(MSBuildThisFileDirectory)..\..</LalaSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Dalamud" HintPath="$(DalamudLibPath)\Dalamud.dll" />
    <Reference Include="Dalamud.Bindings.ImGui" HintPath="$(DalamudLibPath)\Dalamud.Bindings.ImGui.dll" />
    <None Include="$(DalamudLibPath)\cimgui.dll" Link="cimgui.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Shared render core: rasterizer, PNG writer, game-look setup. -->
  <ItemGroup>
    <Compile Include="..\HarnessShared\UiRender\*.cs" Link="UiRender\%(Filename)%(Extension)" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LalaSourceRoot</_Parameter1>
      <_Parameter2>$(LalaSourceRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Scenarios.cs" />
    <Compile Include="Checks.cs" />
    <Compile Include="Stubs.cs" />
  </ItemGroup>

  <!-- The real window sources under test and the shared kit they draw with. -->
  <ItemGroup>
    <Compile Include="$(LalaSourceRoot)\src\LazySkywardTracker\TrackerWindow.cs" Link="Real\TrackerWindow.cs" />
    <Compile Include="$(LalaSourceRoot)\src\LazySkywardTracker\SkywardChrome.cs" Link="Real\SkywardChrome.cs" />
    <Compile Include="$(LalaSourceRoot)\src\Shared\LalaUiKit\**\*.cs" Link="Real\LalaUiKit\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
