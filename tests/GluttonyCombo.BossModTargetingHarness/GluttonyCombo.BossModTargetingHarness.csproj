<Project Sdk="Microsoft.NET.Sdk">
  <!-- Status-immunity seam + endpoint latch (originally the boss-mod targeting checkbox
       harness v1.0.4.241; the checkbox itself was removed in the Fight Brain 1a build —
       stock BMR has no Hints.PriorityTarget). Offline asserts of what still ships:
       BossModTargetingGate's status-immunity seam (compiled from the REAL
       src/GluttonyCombo/GluttonyCombo/AutoRotation/BossModTargetingGate.cs — any Dalamud
       type leaking in breaks this build, which is the point) and the IpcEndpointLatch
       behind the live SetTransient distance write.
         dotnet build tests/GluttonyCombo.BossModTargetingHarness -c Release
         dotnet tests/GluttonyCombo.BossModTargetingHarness/bin/Release/net10.0/GluttonyCombo.BossModTargetingHarness.dll
       Prints PASS/FAIL per case, "OK" and exit 0 when every case passes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GluttonyCombo.BossModTargetingHarness</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1574;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\AutoRotation\BossModTargetingGate.cs" Link="BossModTargetingGate.cs" />
    <!-- bst1013: the endpoint-missing latch behind GetPriorityTargetId and the SetTransient distance write. -->
    <Compile Include="..\..\src\GluttonyCombo\GluttonyCombo\Services\IPC\IpcEndpointLatch.cs" Link="IpcEndpointLatch.cs" />
  </ItemGroup>
</Project>
