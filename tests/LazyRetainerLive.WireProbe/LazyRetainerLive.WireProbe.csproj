<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <!-- Dalamud-free: compiles ONLY the wire layer (RetainerState.cs), which has
         no Dalamud/game references. Proves the exact JSON bytes the plugin will
         serve, against the relay's documented frame shape, before anything
         touches the game. -->
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\LazyRetainerLive\LazyRetainerLive\RetainerState.cs" Link="RetainerState.cs" />
  </ItemGroup>
</Project>
