<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain console app, no Dalamud. Compiles the REAL
       src/LazyFoodBuff/LazyFoodBuff/FoodTelemetryFormat.cs (the pure half of LazyFoodBuff's
       decision tap, v0.1.4.0) so the emitted line format and the two gates are
       asserted offline, against the exact code that ships. Any Dalamud type leaking into
       that file breaks this build, which is the point.
         dotnet build tests\LazyFoodBuff.TelemetryHarness -c Release
         dotnet tests\LazyFoodBuff.TelemetryHarness\bin\Release\net10.0\LazyFoodBuff.TelemetryHarness.dll
       Prints PASS/FAIL per case, "OK" and exit 0 when every case passes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>LazyFoodBuff.TelemetryHarness</RootNamespace>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1574;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\LazyFoodBuff\LazyFoodBuff\FoodTelemetryFormat.cs" Link="FoodTelemetryFormat.cs" />
    <!-- Real ffxivdb player_samples rows collapsed to change-points; the replay at the
         end of Program.cs reads this from AppContext.BaseDirectory to produce a
         MEASURED line rate. -->
    <None Include="trace-ffxivdb.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
