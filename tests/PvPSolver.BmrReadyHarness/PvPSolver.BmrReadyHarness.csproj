<Project Sdk="Microsoft.NET.Sdk">
  <!-- PvPSolver BMR-ready harness (2026-10-08). Plain console app. IPCSubscriber_Common.IsReady("BossModReborn")
       asked ECommons' DalamudReflector.TryGetDalamudPlugin, whose typed cast to IDalamudPlugin throws
       InvalidCastException for BossMod.Plugin (separate load context): it answered false while BossModReborn
       was loaded, and logged an ERR with a stack trace per call, once per frame from the config window
       (11,507 lines in 35 minutes, fingerprint 1aca201c1ca7). The check now reads Dalamud's installed-plugin
       list (name, internal name, loaded flag), which never casts and never logs.
         dotnet run -c Release on project tests/PvPSolver.BmrReadyHarness
       Prints PASS/FAIL per case, "OK (n checks)" and exit 0 when every case passes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PvPSolver.BmrReadyHarness</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS1574;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PvPSolver\PvPSolver\PvPSolver.csproj" />
  </ItemGroup>
</Project>
