<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Authors>dajoey</Authors>
    <Version>0.1.0.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Description>Catalogs every recipe you can craft, buckets them by how much effort the missing materials take, prices them with Universalis, and hands the missing-material work to Artisan / GBR / ARC / Lifestream.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>8.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Numerics" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="LazyCrafter.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- ECommons pinned to match LazyFateAutomation; LuminaSupplemental matches GBR 4.3.x (Plan §Phase 0). -->
    <PackageReference Include="ECommons" Version="3.2.0.9" />
    <PackageReference Include="LuminaSupplemental.Excel" Version="4.3.0" />
  </ItemGroup>

  <!-- Keep the zip lean: ship only our DLL and the two nuget deps. Drops
       Microsoft.Windows.SDK.NET.dll (~26 MB) and WinRT.Runtime.dll, which the
       game host already provides. Same convention as LazyFateAutomation. -->
  <Target Name="PruneOutputDlls" AfterTargets="ResolveReferences">
    <ItemGroup>
      <_KeepDlls Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'LazyCrafter' or '%(Filename)' == 'ECommons' or '%(Filename)' == 'LuminaSupplemental.Excel'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
      <ReferenceCopyLocalPaths Include="@(_KeepDlls)" />
    </ItemGroup>
  </Target>
</Project>
