<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.1.0</Version>
    <AssemblyName>LazyCrucible</AssemblyName>
    <Description>Crucible of the Unbroken (Beastmaster) familiar selection: fills the run roster and the Battlehorn slots for each fight's mechanics, with a beast-pick advisor and a read-only screen recorder.</Description>
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>8.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Author>dajoey</Author>
    <Name>LazyCrucible</Name>
    <InternalName>LazyCrucible</InternalName>
    <Punchline>Crucible of the Unbroken familiar picks, filled in for every fight</Punchline>
    <ApplicableVersion>any</ApplicableVersion>
    <Tags>beastmaster;bst;crucible;unbroken;familiar;battlehorn;automation</Tags>
    <CategoryTags>jobs;utility</CategoryTags>
    <DalamudApiLevel>15</DalamudApiLevel>
    <LoadRequiredState>0</LoadRequiredState>
    <LoadSync>false</LoadSync>
    <CanUnloadAsync>false</CanUnloadAsync>
    <LoadPriority>0</LoadPriority>
    <AcceptsFeedback>false</AcceptsFeedback>
    <!-- Error reporting (2026-09-21): the PDB lives INSIDE the DLL, so stack traces in ER| lines carry
         file:line even though packaging ships no .pdb. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <!-- Shared in-game "What's new" changelog popup (standing rule, 2026-09-05): compiled as SOURCE and
       this plugin's CHANGELOG.md embedded. Do not remove. -->
  <ItemGroup>
    <Compile Include="..\Shared\LalaChangelog\**\*.cs" Link="LalaChangelog\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="CHANGELOG.md" LogicalName="CHANGELOG.md" />
    <EmbeddedResource Include="Guide\CrucibleGuide.json" LogicalName="CrucibleGuide.json" />
  </ItemGroup>
  <!-- Crucible data + beast-pick ranking shared with GluttonyCombo's Beastmaster rotation, as SOURCE
       (each plugin has its own AssemblyLoadContext; a shared DLL would be pruned). -->
  <ItemGroup>
    <Compile Include="..\Shared\LalaCrucible\**\*.cs" Link="LalaCrucible\%(RecursiveDir)%(Filename)%(Extension)" />
    <Using Include="Lalalazy.Crucible" />
  </ItemGroup>
  <!-- Shared error reporting (src/Shared/LalaTelemetry, 2026-09-21): ER| error lines, circuit breakers on the
       per-frame tick and the screen hooks, `/lazycrucible report`. Shared SOURCE like LalaChangelog, never a DLL.
       Do not remove. -->
  <ItemGroup>
    <Compile Include="..\Shared\LalaTelemetry\**\*.cs" Link="LalaTelemetry\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Build stamp for the shared error reporting: the git SHA of the tree being built goes into
       [AssemblyMetadata("LalaCommit")] and onto every ER| / RP| line as c=. "unknown" without git. -->
  <Import Project="..\Shared\LalaTelemetry\LalaTelemetry.Stamp.targets" />
  <ItemGroup>
    <Content Include="LazyCrucible.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ECommons" Version="3.2.0.9" />
  </ItemGroup>
  <Target Name="PruneOutputDlls" AfterTargets="ResolveReferences">
    <ItemGroup>
      <_KeepDlls Include="@(ReferenceCopyLocalPaths)" Condition="           '%(Filename)' == 'LazyCrucible' or           '%(Filename)' == 'ECommons'         " />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
      <ReferenceCopyLocalPaths Include="@(_KeepDlls)" />
    </ItemGroup>
  </Target>
</Project>
