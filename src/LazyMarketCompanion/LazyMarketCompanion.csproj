<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Authors>dajoey</Authors>
    <Version>0.1.68.0</Version>
    <AssemblyVersion>0.1.68.0</AssemblyVersion>
    <FileVersion>0.1.68.0</FileVersion>
    <Description>Market board companion: automatically lists your always-sell items through your retainers in the stack sizes you choose, prices them by matching (not undercutting) the board, and can run inside AutoRetainer's venture cycle. Successor to Dagobert Price Matcher.</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>8.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>1591</NoWarn>
    <!-- Error reporting (2026-09-21): the PDB lives INSIDE the DLL, so stack traces in ER| lines carry
         file:line even though packaging ships no .pdb. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- Shared in-game "What's new" changelog popup (standing rule, 2026-09-05): every lalalazy
       plugin compiles src/Shared/LalaChangelog as SOURCE (never a shared DLL - each plugin lives in
       its own AssemblyLoadContext and PruneOutputDlls would strip it) and embeds its own CHANGELOG.md.
       Do not remove this block in an upstream merge. -->
  <ItemGroup>
    <Compile Include="..\Shared\LalaChangelog\**\*.cs" Link="LalaChangelog\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="CHANGELOG.md" LogicalName="CHANGELOG.md" />
  </ItemGroup>

  <!-- Shared error reporting (src/Shared/LalaTelemetry, 2026-09-21): ER| error lines, circuit breakers on the
       per-frame handlers, `/lmc report`. Shared SOURCE like LalaChangelog, never a DLL. Do not remove in a merge. -->
  <ItemGroup>
    <Compile Include="..\Shared\LalaTelemetry\**\*.cs" Link="LalaTelemetry\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Build stamp for the shared error reporting (src/Shared/LalaTelemetry): the git SHA of the tree being built
       goes into [AssemblyMetadata("LalaCommit")] and onto every ER| / RP| line as c=. "unknown" without git. -->
  <Import Project="..\Shared\LalaTelemetry\LalaTelemetry.Stamp.targets" />

  <ItemGroup>
    <Content Include="LazyMarketCompanion.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same ECommons pin as LazyCrafter / LazyFateAutomation. -->
    <PackageReference Include="ECommons" Version="3.2.0.9" />
  </ItemGroup>

  <!-- Ship only our DLL + ECommons. Dalamud provides everything else in the host. -->
  <Target Name="PruneOutputDlls" AfterTargets="ResolveReferences">
    <ItemGroup>
      <_KeepDlls Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'LazyMarketCompanion' or '%(Filename)' == 'ECommons'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
      <ReferenceCopyLocalPaths Include="@(_KeepDlls)" />
    </ItemGroup>
  </Target>
</Project>
