<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <PackageId>LazyCurrencySpender</PackageId>
    <Authors>Blackcatz1911, dajoey</Authors>
    <Version>1.2.7.0</Version>
    <Description>Lazy Currency Spender — FFXIV Plugin to find the best options to spend your ingame currency. Fork of CurrencySpender by Blackcatz1911.</Description>
    <PackageProjectUrl>https://github.com/dajoey/lalalazy</PackageProjectUrl>
    <RepoUrl>https://github.com/dajoey/lalalazy</RepoUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <Platforms>x64</Platforms>
    <AssemblyVersion>1.2.7.0</AssemblyVersion>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>8.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);MSB3277;1591</NoWarn>
  </PropertyGroup>
  
  <ItemGroup>
    <Content Include="CHANGELOG.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>true</Visible>
    </Content>
  </ItemGroup>
  
  <!-- Shared in-game "What's new" changelog popup (standing rule, 2026-09-05): every lalalazy
       plugin compiles src/Shared/LalaChangelog as SOURCE (never a shared DLL - each plugin lives in
       its own AssemblyLoadContext and PruneOutputDlls would strip it) and embeds its own CHANGELOG.md.
       This is a FORK: the seen-version lives in a sidecar json, never in the upstream-owned Config
       class, so upstream CurrencySpender syncs stay conflict-free.
       Do not remove this block in an upstream merge. -->
  <ItemGroup>
    <Compile Include="..\Shared\LalaChangelog\**\*.cs" Link="LalaChangelog\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="CHANGELOG.md" LogicalName="CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ECommons" Version="3.1.0.5" />
  </ItemGroup>

   <ItemGroup Condition="!Exists('$(ProjectDir)..\FFXIVClientStructs')">
    <Reference Include="InteropGenerator.Runtime" Private="false" />
    <Reference Include="FFXIVClientStructs" Private="false" />
  </ItemGroup>

  <PropertyGroup Condition="Exists('$(ProjectDir)..\FFXIVClientStructs')">
    <Use_Dalamud_FFXIVClientStructs>false</Use_Dalamud_FFXIVClientStructs>
    <InteropGenerator_InteropNamespace>LazyCurrencySpender</InteropGenerator_InteropNamespace>
    <DefineConstants>HAS_LOCAL_CS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(ProjectDir)..\FFXIVClientStructs')">
    <CompilerVisibleProperty Include="InteropGenerator_InteropNamespace" />
    <ProjectReference Include="..\FFXIVClientStructs\InteropGenerator\InteropGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\FFXIVClientStructs\FFXIVClientStructs\FFXIVClientStructs.csproj" Private="True" />
    <ProjectReference Include="..\FFXIVClientStructs\InteropGenerator.Runtime\InteropGenerator.Runtime.csproj" Private="True" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="DotNet.ReproducibleBuilds" Version="1.2.25" />
  </ItemGroup>

  <Target Name="Message" BeforeTargets="BeforeBuild">
    <Message Text="Dalamud.Plugin: root at $(DalamudLibPath)" Importance="high" />
  </Target>
</Project>
