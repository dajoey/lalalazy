<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Authors>dajoey</Authors>
    <Version>0.6.2.0</Version>
    <AssemblyVersion>0.6.2.0</AssemblyVersion>
    <FileVersion>0.6.2.0</FileVersion>
    <Description>Gold Saucer Fashion Report assistant: weekly hints, exact dyes, owned-item candidates, and a live outfit scorer.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>8.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Numerics" />
  </ItemGroup>

  <!-- Shared in-game "What's new" changelog popup (standing rule, 2026-09-05): every lalalazy
       plugin compiles src/Shared/LalaChangelog as SOURCE (never a shared DLL - each plugin lives in
       its own AssemblyLoadContext and PruneOutputDlls would strip it) and embeds its own CHANGELOG.md.
       Do not remove this block in an upstream merge. -->
  <ItemGroup>
    <Compile Include="..\..\Shared\LalaChangelog\**\*.cs" Link="LalaChangelog\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
  </ItemGroup>

  <!-- Buy leg (v0.3.0.0): LuminaSupplemental matches LazyCrafter/GBR 4.3.x — ENpcShop + ENpcPlace
       place the vendors. Sylvan.Data.Csv is NOT optional (LazyCrafter t_1a91db8f lesson):
       CsvLoader.LoadResource reads every embedded CSV through it, Dalamud ships no CSV reader,
       and each plugin lives in its own AssemblyLoadContext. -->
  <ItemGroup>
    <PackageReference Include="LuminaSupplemental.Excel" Version="4.3.0" />
  </ItemGroup>

  <!-- Keep the zip lean: ship our DLL plus the buy-leg deps the game host does not provide. -->
  <Target Name="PruneOutputDlls" AfterTargets="ResolveReferences">
    <ItemGroup>
      <_KeepDlls Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'LazyFashionReport' or '%(Filename)' == 'LuminaSupplemental.Excel' or '%(Filename)' == 'Sylvan.Data.Csv'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" />
      <ReferenceCopyLocalPaths Include="@(_KeepDlls)" />
    </ItemGroup>
  </Target>
</Project>
